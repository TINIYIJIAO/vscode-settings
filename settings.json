{
  // ============================================
  //  字体 & 显示
  // ============================================
  "editor.fontFamily": "'Cascadia Code', 'JetBrains Mono', 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace",
  "editor.fontSize": 16,
  "editor.lineHeight": 1.6,
  "editor.fontWeight": "normal",
  "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'zero'",
  "editor.letterSpacing": 0,

  // ============================================
  //  光标
  // ============================================
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 2,
  "editor.cursorStyle": "line",

  // ============================================
  //  视觉 & 排版
  // ============================================
  "editor.renderWhitespace": "selection",
  "editor.renderLineHighlight": "all",
  "editor.renderIndentGuides": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": true,
  "editor.padding.top": 4,
  "editor.scrollBeyondLastLine": false,

  // Minimap
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 80,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.scale": 1,
  "editor.minimap.showSlider": "mouseover",

  // ============================================
  //  缩进 & 换行
  // ============================================
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.wordWrap": "off",
  "editor.rulers": [80, 100, 120],
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // ============================================
  //  语言特定
  // ============================================
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": false
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[html]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[css]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  // ============================================
  //  工作区外观
  // ============================================
  "workbench.colorTheme": "Default Dark+",
  "workbench.iconTheme": "vs-seti",
  "workbench.tree.indent": 16,
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "window.zoomLevel": 0,

  // ============================================
  //  终端
  // ============================================
  "terminal.integrated.fontFamily": "'Cascadia Code', 'JetBrains Mono', Consolas, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",

  // ============================================
  //  其他
  // ============================================
  "editor.linkedEditing": true,
  "editor.occurrencesHighlight": "singleFile",
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "top",
  "breadcrumbs.enabled": true,
  "diffEditor.renderSideBySide": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // ============================================
  //  文件排除（侧栏清爽）
  // ============================================
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/node_modules": true
  },

  // ============================================
  //  搜索排除
  // ============================================
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.git": true
  }
}
